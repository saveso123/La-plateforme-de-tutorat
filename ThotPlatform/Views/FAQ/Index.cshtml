@model IEnumerable<ThotPlatform.Models.Question>

@{
    ViewBag.Title = "FAQ - Foire Aux Questions";
}

<style>
    .faq-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 80px 0 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .faq-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="rgba(255,255,255,0.1)" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,138.7C960,139,1056,117,1152,106.7C1248,96,1344,96,1392,96L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') no-repeat bottom;
        background-size: cover;
    }

    .faq-hero h1 {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 20px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        position: relative;
        z-index: 1;
    }

    .faq-hero p {
        font-size: 1.3rem;
        opacity: 0.95;
        position: relative;
        z-index: 1;
    }

    .search-box-container {
        max-width: 800px;
        margin: 40px auto 0;
        position: relative;
        z-index: 1;
    }

    .search-box {
        background: white;
        border-radius: 50px;
        padding: 10px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        display: flex;
        align-items: center;
    }

    .search-box input {
        flex: 1;
        border: none;
        padding: 15px 25px;
        font-size: 1.1rem;
        outline: none;
    }

    .search-box button {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 15px 35px;
        border-radius: 50px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .search-box button:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }

    .stats-bar {
        background: white;
        padding: 30px 0;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .stat-item {
        text-align: center;
        padding: 20px;
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: #667eea;
        display: block;
    }

    .stat-label {
        color: #666;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .filters-section {
        padding: 40px 0;
        background: #f8f9fa;
    }

    .filter-chip {
        display: inline-block;
        padding: 10px 20px;
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 25px;
        margin: 5px;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        color: #333;
    }

    .filter-chip:hover, .filter-chip.active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-color: #667eea;
        transform: translateY(-2px);
    }

    .questions-container {
        padding: 50px 0;
    }

    .question-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: all 0.3s;
        border-left: 5px solid #667eea;
    }

    .question-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .question-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .question-title i {
        color: #667eea;
        font-size: 1.5rem;
    }

    .question-preview {
        color: #666;
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .question-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .meta-badges {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .badge-custom {
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-domaine {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .badge-reponses {
        background: #4caf50;
        color: white;
    }

    .badge-date {
        background: #f0f0f0;
        color: #666;
    }

    .btn-voir-reponse {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 10px 25px;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
        display: inline-block;
    }

    .btn-voir-reponse:hover {
        transform: translateX(5px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        color: white;
    }

    .no-results {
        text-align: center;
        padding: 80px 20px;
    }

    .no-results i {
        font-size: 5rem;
        color: #ccc;
        margin-bottom: 20px;
    }

    .floating-help {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        box-shadow: 0 5px 20px rgba(102, 126, 234, 0.5);
        cursor: pointer;
        transition: all 0.3s;
        z-index: 1000;
    }

    .floating-help:hover {
        transform: scale(1.1);
        box-shadow: 0 8px 30px rgba(102, 126, 234, 0.7);
    }
</style>

<!-- Hero Section -->
<div class="faq-hero">
    <div class="container">
        <div class="mb-3">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light">
                <i class="bi bi-arrow-left"></i> Retour a l'accueil
            </a>
        </div>
        <h1><i class="bi bi-question-circle-fill"></i> Foire Aux Questions</h1>
        <p>Trouvez rapidement des reponses a vos questions</p>

        <!-- Search Box -->
        <div class="search-box-container">
            <form action="@Url.Action("Index")" method="get">
                <div class="search-box">
                    <i class="bi bi-search" style="color: #667eea; font-size: 1.5rem; margin-left: 15px;"></i>
                    <input type="text" name="recherche" placeholder="Rechercher une question..." value="@ViewBag.RechercheActuelle">
                    <button type="submit">
                        <i class="bi bi-search"></i> Rechercher
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Stats Bar -->
<div class="stats-bar">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <div class="stat-item">
                    <span class="stat-number">@ViewBag.TotalQuestions</span>
                    <span class="stat-label">Questions Resolues</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-item">
                    <span class="stat-number">@ViewBag.DomainesCount</span>
                    <span class="stat-label">Domaines</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-item">
                    <span class="stat-number">@Model.Count()</span>
                    <span class="stat-label">Resultats Affiches</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="filters-section">
    <div class="container">
        <h4 class="mb-3"><i class="bi bi-funnel"></i> Filtrer par Domaine</h4>
        <div>
            <a href="@Url.Action("Index")" class="filter-chip @(ViewBag.DomaineActuel == null ? "active" : "")">
                <i class="bi bi-grid"></i> Tous
            </a>
            @foreach (var domaine in (IEnumerable<ThotPlatform.Models.Domaine>)ViewBag.Domaines)
            {
                <a href="@Url.Action("Index", new { domaineId = domaine.DomaineId, recherche = ViewBag.RechercheActuelle })" 
                   class="filter-chip @(ViewBag.DomaineActuel == domaine.DomaineId ? "active" : "")">
                    @domaine.Nom
                </a>
            }
        </div>
    </div>
</div>

<!-- Questions List -->
<div class="questions-container">
    <div class="container">
        @if (Model.Any())
        {
            foreach (var question in Model)
            {
                <div class="question-card">
                    <div class="question-title">
                        <i class="bi bi-chat-left-text-fill"></i>
                        @question.Titre
                    </div>
                    <div class="question-preview">
                        @(question.Contenu.Length > 200 ? question.Contenu.Substring(0, 200) + "..." : question.Contenu)
                    </div>
                    <div class="question-meta">
                        <div class="meta-badges">
                            <span class="badge-custom badge-domaine">
                                <i class="bi bi-bookmark"></i> @question.Domaine.Nom
                            </span>
                            <span class="badge-custom badge-reponses">
                                <i class="bi bi-chat-dots"></i> @question.Reponses.Count(r => r.EstValidee) reponse(s)
                            </span>
                            <span class="badge-custom badge-date">
                                <i class="bi bi-calendar"></i> @question.DateCreation.ToString("dd/MM/yyyy")
                            </span>
                        </div>
                        <a href="@Url.Action("Details", new { id = question.QuestionId })" class="btn-voir-reponse">
                            Voir la reponse <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-results">
                <i class="bi bi-inbox"></i>
                <h3>Aucune question trouvee</h3>
                <p class="text-muted">Essayez de modifier vos criteres de recherche</p>
            </div>
        }
    </div>
</div>

<!-- Floating Help Button -->
<a href="@Url.Action("Create", "Question")" class="floating-help" title="Poser une question">
    <i class="bi bi-plus-lg"></i>
</a>

@section Scripts {
    <script>
        // Autocomplete pour la recherche
        $('input[name="recherche"]').autocomplete({
            source: '@Url.Action("Recherche", "FAQ")',
            minLength: 2,
            select: function(event, ui) {
                window.location.href = '@Url.Action("Details", "FAQ")/' + ui.item.id;
            }
        });
    </script>
}

