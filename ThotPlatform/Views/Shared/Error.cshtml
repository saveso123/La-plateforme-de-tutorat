@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Erreur";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2><i class="bi bi-exclamation-triangle"></i> Une erreur s'est produite</h2>
                </div>
                <div class="card-body">
                    <h4 class="text-danger">Erreur : @Model.Exception.GetType().Name</h4>
                    <p class="lead">@Model.Exception.Message</p>
                    
                    @if (Model != null)
                    {
                        <hr />
                        <h5>Dtails de l'erreur :</h5>
                        <dl class="row">
                            <dt class="col-sm-3">Contrleur :</dt>
                            <dd class="col-sm-9">@Model.ControllerName</dd>
                            
                            <dt class="col-sm-3">Action :</dt>
                            <dd class="col-sm-9">@Model.ActionName</dd>
                        </dl>
                    }
                    
                    <div class="mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                            <i class="bi bi-house"></i> Retour  l'accueil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

