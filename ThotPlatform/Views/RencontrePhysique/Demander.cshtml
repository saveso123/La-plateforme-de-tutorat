@model ThotPlatform.Models.RencontrePhysique

@{
    ViewBag.Title = "Demander une Rencontre";
}

<style>
    .rencontre-container {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        min-height: 100vh;
        padding: 50px 0;
    }

    .rencontre-card {
        background: white;
        border-radius: 25px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.2);
        overflow: hidden;
        animation: fadeInUp 0.6s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card-header-rencontre {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        padding: 40px;
        text-align: center;
        color: white;
    }

    .card-header-rencontre h1 {
        font-weight: 800;
        font-size: 2.5rem;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }

    .card-header-rencontre p {
        font-size: 1.1rem;
        opacity: 0.95;
    }

    .form-content {
        padding: 50px;
    }

    .step-indicator {
        display: flex;
        justify-content: space-between;
        margin-bottom: 40px;
        position: relative;
    }

    .step-indicator::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 3px;
        background: #e0e0e0;
        z-index: 0;
    }

    .step {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e0e0e0;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        font-weight: 700;
        transition: all 0.3s;
    }

    .step.active .step-circle {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        transform: scale(1.2);
        box-shadow: 0 5px 15px rgba(250, 112, 154, 0.4);
    }

    .form-section {
        background: #f8f9fa;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 25px;
        border-left: 5px solid #fa709a;
    }

    .form-section h4 {
        color: #fa709a;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-label i {
        color: #fa709a;
        font-size: 1.2rem;
    }

    .form-control, .form-select {
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 15px;
        transition: all 0.3s;
        font-size: 1rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #fa709a;
        box-shadow: 0 0 0 0.2rem rgba(250, 112, 154, 0.25);
    }

    .info-box {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 25px;
        border-left: 5px solid #2196f3;
    }

    .info-box i {
        font-size: 2rem;
        color: #2196f3;
        margin-right: 15px;
    }

    .tarif-preview {
        background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        margin: 25px 0;
        border: 3px dashed #ff9800;
    }

    .tarif-preview h3 {
        color: #ff9800;
        font-weight: 800;
        font-size: 2.5rem;
        margin: 10px 0;
    }

    .tarif-badge {
        background: #4caf50;
        color: white;
        padding: 8px 20px;
        border-radius: 20px;
        display: inline-block;
        font-weight: 600;
        margin-top: 10px;
    }

    .btn-submit-rencontre {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        border: none;
        padding: 18px 50px;
        font-size: 1.2rem;
        font-weight: 700;
        border-radius: 50px;
        color: white;
        box-shadow: 0 8px 20px rgba(250, 112, 154, 0.4);
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-submit-rencontre:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(250, 112, 154, 0.6);
    }

    .advantages-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin: 30px 0;
    }

    .advantage-card {
        background: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: all 0.3s;
    }

    .advantage-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    .advantage-card i {
        font-size: 3rem;
        color: #fa709a;
        margin-bottom: 15px;
    }
</style>

<div class="rencontre-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="rencontre-card">
                    <div class="card-header-rencontre">
                        <h1><i class="bi bi-people-fill"></i> Demander une Rencontre</h1>
                        <p>Rencontrez un tuteur en personne pour un apprentissage personnalise</p>
                    </div>

                    <div class="form-content">
                        <!-- Avantages -->
                        <div class="advantages-grid">
                            <div class="advantage-card">
                                <i class="bi bi-person-check"></i>
                                <h5>Tuteur Qualifie</h5>
                                <p class="text-muted small">Experts certifies</p>
                            </div>
                            <div class="advantage-card">
                                <i class="bi bi-geo-alt"></i>
                                <h5>A Proximite</h5>
                                <p class="text-muted small">Lieu pratique</p>
                            </div>
                            <div class="advantage-card">
                                <i class="bi bi-clock-history"></i>
                                <h5>Flexible</h5>
                                <p class="text-muted small">Horaire adapte</p>
                            </div>
                            <div class="advantage-card">
                                <i class="bi bi-star-fill"></i>
                                <h5>Tarif Preferentiel</h5>
                                <p class="text-muted small">Pour abonnes</p>
                            </div>
                        </div>

                        @using (Html.BeginForm("Demander", "RencontrePhysique", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <!-- Section 1: Domaine -->
                            <div class="form-section">
                                <h4><i class="bi bi-book"></i> Choisissez le Domaine</h4>
                                <div class="row">
                                    <div class="col-md-12">
                                        <label class="form-label">
                                            <i class="bi bi-bookmark"></i>
                                            Domaine d'etude
                                        </label>
                                        @Html.DropDownListFor(m => m.DomaineId, (SelectList)ViewBag.Domaines, "Selectionnez un domaine", new { @class = "form-select" })
                                        @Html.ValidationMessageFor(m => m.DomaineId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <!-- Section 2: Date et Duree -->
                            <div class="form-section">
                                <h4><i class="bi bi-calendar-event"></i> Date et Duree</h4>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-calendar3"></i>
                                            Date et heure
                                        </label>
                                        @Html.TextBoxFor(m => m.DateHeure, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                                        @Html.ValidationMessageFor(m => m.DateHeure, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-hourglass-split"></i>
                                            Duree (heures)
                                        </label>
                                        @Html.TextBoxFor(m => m.DureeHeures, new { @class = "form-control", type = "number", min = "0.5", max = "8", step = "0.5" })
                                        @Html.ValidationMessageFor(m => m.DureeHeures, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <!-- Section 3: Lieu -->
                            <div class="form-section">
                                <h4><i class="bi bi-geo-alt"></i> Lieu de Rencontre</h4>
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-pin-map"></i>
                                            Adresse
                                        </label>
                                        @Html.TextBoxFor(m => m.Lieu, new { @class = "form-control", placeholder = "Ex: Bibliotheque municipale, 123 rue Principale" })
                                        @Html.ValidationMessageFor(m => m.Lieu, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label">
                                            <i class="bi bi-chat-text"></i>
                                            Description (optionnel)
                                        </label>
                                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Precisez vos besoins, sujets a aborder, etc." })
                                    </div>
                                </div>
                            </div>

                            <!-- Info Box -->
                            <div class="info-box d-flex align-items-center">
                                <i class="bi bi-info-circle-fill"></i>
                                <div>
                                    <strong>Comment ca marche ?</strong>
                                    <p class="mb-0">Un tuteur qualifie dans le domaine choisi vous sera automatiquement assigne. Vous recevrez une confirmation par email avec tous les details.</p>
                                </div>
                            </div>

                            <!-- Tarif Preview -->
                            <div class="tarif-preview">
                                <p class="mb-0"><strong>Tarif Estime</strong></p>
                                <h3 id="tarif-display">--</h3>
                                <small class="text-muted">Le tarif final sera confirme par le tuteur</small>
                                <div class="mt-2">
                                    <span class="tarif-badge">
                                        <i class="bi bi-star"></i> -20% pour les abonnes
                                    </span>
                                </div>
                            </div>

                            <!-- Boutons -->
                            <div class="d-flex justify-content-between align-items-center mt-4">
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-arrow-left"></i> Retour
                                </a>
                                <button type="submit" class="btn-submit-rencontre">
                                    <i class="bi bi-send-fill"></i> Envoyer la Demande
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Calculer et afficher le tarif estime
        function updateTarif() {
            var duree = parseFloat($('#DureeHeures').val()) || 1;
            var tarifBase = 35; // Tarif moyen
            var total = tarifBase * duree;
            $('#tarif-display').text(total.toFixed(2) + ' $');
        }

        $('#DureeHeures').on('input', updateTarif);
        $(document).ready(updateTarif);
    </script>
}

