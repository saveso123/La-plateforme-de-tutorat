@model IEnumerable<ThotPlatform.ViewModels.CoursViewModel>

@{
    ViewBag.Title = "Mes Cours";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Mes Cours</h2>
            <p class="text-muted">Liste de tous les cours que vous avez crees</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create", "Cours")" class="btn btn-primary">
                Creer un nouveau cours
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var cours in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header @(cours.EstPublie ? "bg-success" : "bg-secondary") text-white">
                            <h5 class="mb-0">@cours.Nom</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">@cours.Description</p>
                            
                            <div class="mb-2">
                                <span class="badge bg-primary">@cours.DomaineNom</span>
                                <span class="badge bg-info">@cours.Niveau</span>
                                <span class="badge bg-warning text-dark">@cours.DureeEstimeeHeures heures</span>
                            </div>

                            <p class="text-muted mb-0">
                                <small>
                                    Code : @cours.Code<br />
                                    Modules : @cours.NombreModules<br />
                                    Cree le : @cours.DateCreation.ToString("dd/MM/yyyy")
                                </small>
                            </p>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("DetailsCours", "Tuteur", new { id = cours.CoursId })" class="btn btn-sm btn-outline-primary">
                                    Voir details
                                </a>
                                <a href="@Url.Action("Edit", "Cours", new { id = cours.CoursId })" class="btn btn-sm btn-outline-warning">
                                    Modifier
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h5>Aucun cours</h5>
            <p class="mb-0">Vous n'avez pas encore cree de cours.</p>
            <a href="@Url.Action("Create", "Cours")" class="btn btn-primary mt-3">
                Creer mon premier cours
            </a>
        </div>
    }

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Tuteur")" class="btn btn-outline-secondary">Retour au tableau de bord</a>
    </div>
</div>

