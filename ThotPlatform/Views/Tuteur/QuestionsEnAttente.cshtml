@model IEnumerable<ThotPlatform.ViewModels.QuestionEnAttenteViewModel>

@{
    ViewBag.Title = "Questions en attente";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Questions en attente de reponse</h2>
            <p class="text-muted">Selectionnez une question pour y repondre</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var question in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-warning">
                            <h5 class="mb-0">@question.Titre</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">@(question.Contenu.Length > 150 ? question.Contenu.Substring(0, 150) + "..." : question.Contenu)</p>
                            
                            <div class="mb-2">
                                <span class="badge bg-primary">@question.DomaineNom</span>
                                <span class="badge bg-info">@question.EtudiantNiveau</span>
                            </div>

                            <p class="text-muted mb-0">
                                <small>
                                    Posee par : @question.EtudiantNomComplet<br />
                                    Date : @question.DateCreation.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </p>
                        </div>
                        <div class="card-footer">
                            <a href="@Url.Action("Answer", "Question", new { id = question.QuestionId })" class="btn btn-success w-100">
                                Repondre a cette question
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h5>Aucune question en attente</h5>
            <p class="mb-0">Il n'y a actuellement aucune question en attente de reponse.</p>
        </div>
    }

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Tuteur")" class="btn btn-outline-secondary">Retour au tableau de bord</a>
    </div>
</div>

