@model IEnumerable<ThotPlatform.ViewModels.EtudiantInscritViewModel>

@{
    ViewBag.Title = "Mes Etudiants";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-people"></i> Mes Etudiants</h2>
            <p class="text-muted">Liste de tous les etudiants inscrits a vos cours</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-info">
                <strong>Total :</strong> @ViewBag.NombreEtudiants etudiant(s) inscrit(s)
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Prenom</th>
                        <th>Email</th>
                        <th>Niveau</th>
                        <th>Nombre de Cours</th>
                        <th>Derniere Inscription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var etudiant in Model)
                    {
                        <tr>
                            <td><strong>@etudiant.Nom</strong></td>
                            <td>@etudiant.Prenom</td>
                            <td>
                                <a href="mailto:@etudiant.Email">@etudiant.Email</a>
                            </td>
                            <td>
                                <span class="badge bg-primary">@etudiant.Niveau</span>
                            </td>
                            <td>
                                <span class="badge bg-success">@etudiant.NombreCours</span>
                            </td>
                            <td>@etudiant.DerniereInscription.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="@Url.Action("Nouveau", "Message", new { destinataireId = etudiant.UtilisateurId })" 
                                   class="btn btn-sm btn-primary" title="Envoyer un message">
                                    <i class="bi bi-chat-dots"></i> Message
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Aucun etudiant inscrit pour le moment.
        </div>
    }

    <div class="mt-3">
        <a href="@Url.Action("Index", "Tuteur")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour au Dashboard
        </a>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>
