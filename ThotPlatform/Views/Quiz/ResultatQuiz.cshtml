@model ThotPlatform.Models.TentativeQuiz

@{
    ViewBag.Title = "Resultats - " + Model.Quiz.Titre;
    var totalPoints = Model.Quiz.Questions.Sum(q => q.Points);
    var pointsObtenus = Model.Reponses.Sum(r => r.PointsObtenus);
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <!-- Resultat global -->
            <div class="card shadow-lg mb-4 @(Model.EstReussie ? "border-success" : "border-danger")" style="border-width: 3px;">
                <div class="card-header @(Model.EstReussie ? "bg-success" : "bg-danger") text-white text-center py-4">
                    <h2 class="mb-0">
                        <i class="bi @(Model.EstReussie ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                        @(Model.EstReussie ? "Felicitations !" : "Quiz non reussi")
                    </h2>
                </div>
                <div class="card-body text-center py-5">
                    <div class="display-1 mb-3 @(Model.EstReussie ? "text-success" : "text-danger")">
                        @(Model.NoteObtenue.HasValue ? Model.NoteObtenue.Value.ToString("F1") : "0")%
                    </div>
                    <h5 class="text-muted mb-4">
                        @pointsObtenus / @totalPoints points
                    </h5>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="stat-box">
                                <i class="bi bi-question-circle text-primary fs-1"></i>
                                <h6 class="mt-2">Questions</h6>
                                <p class="mb-0">@Model.Quiz.Questions.Count</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-box">
                                <i class="bi bi-check-circle text-success fs-1"></i>
                                <h6 class="mt-2">Correctes</h6>
                                <p class="mb-0">@Model.Reponses.Count(r => r.EstCorrecte)</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-box">
                                <i class="bi bi-clock text-info fs-1"></i>
                                <h6 class="mt-2">Duree</h6>
                                <p class="mb-0">@(Model.Duree?.TotalMinutes.ToString("F0") ?? "N/A") min</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Details des reponses -->
            @if (Model.Quiz.AfficherReponses)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-list-check"></i> Detail des reponses</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var question in Model.Quiz.Questions.OrderBy(q => q.Ordre))
                        {
                            var reponse = Model.Reponses.FirstOrDefault(r => r.QuestionQuizId == question.QuestionQuizId);
                            var estCorrecte = reponse?.EstCorrecte ?? false;

                            <div class="question-result mb-4 p-3 border rounded @(estCorrecte ? "border-success bg-success bg-opacity-10" : "border-danger bg-danger bg-opacity-10")">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="mb-0">
                                        <i class="bi @(estCorrecte ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                                        @question.Texte
                                    </h6>
                                    <span class="badge @(estCorrecte ? "bg-success" : "bg-danger")">
                                        @(reponse?.PointsObtenus ?? 0) / @question.Points pts
                                    </span>
                                </div>

                                @if (question.Type == ThotPlatform.Models.TypeQuestionQuiz.ReponseCourte || question.Type == ThotPlatform.Models.TypeQuestionQuiz.ReponseLongue)
                                {
                                    <div class="mt-3">
                                        <strong>Votre reponse :</strong>
                                        <p class="mb-0 mt-1">@(reponse?.ReponseTexte ?? "Aucune reponse")</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-3">
                                        @foreach (var choix in question.Choix.OrderBy(c => c.Ordre))
                                        {
                                            var estChoixUtilisateur = reponse?.ChoixId == choix.ChoixId;
                                            var estChoixCorrect = choix.EstCorrect;

                                            <div class="form-check mb-2 @(estChoixCorrect ? "fw-bold" : "")">
                                                <input class="form-check-input" type="radio" disabled 
                                                       @(estChoixUtilisateur ? "checked" : "")>
                                                <label class="form-check-label">
                                                    @choix.Texte
                                                    @if (estChoixCorrect)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success ms-2"></i>
                                                        <span class="badge bg-success ms-1">Bonne reponse</span>
                                                    }
                                                    @if (estChoixUtilisateur && !estChoixCorrect)
                                                    {
                                                        <i class="bi bi-x-circle-fill text-danger ms-2"></i>
                                                        <span class="badge bg-danger ms-1">Votre choix</span>
                                                    }
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(question.Explication))
                                {
                                    <div class="alert alert-info mt-3 mb-0">
                                        <strong><i class="bi bi-info-circle"></i> Explication :</strong>
                                        <p class="mb-0 mt-1">@question.Explication</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Tentatives precedentes -->
            @{
                // Les autres tentatives ne peuvent pas etre affichees sans charger l'etudiant avec ses tentatives
                // Pour eviter les erreurs, on les masque pour l'instant
                var autresTentatives = new List<ThotPlatform.Models.TentativeQuiz>();
            }

            @if (autresTentatives.Any())
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-clock-history"></i> Tentatives precedentes</h6>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var tentative in autresTentatives)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge @(tentative.EstReussie ? "bg-success" : "bg-danger")">
                                            @(tentative.NoteObtenue.HasValue ? tentative.NoteObtenue.Value.ToString("F1") : "0")%
                                        </span>
                                        <span class="ms-2 text-muted">
                                            @tentative.DateDebut.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>
                                    <a href="@Url.Action("ResultatQuiz", new { id = tentative.TentativeId })" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Actions -->
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    @{
                        // Nombre de tentatives = tentative actuelle + 1
                        var nombreTentatives = 1; // Au minimum 1 (la tentative actuelle)
                        var peutReessayer = nombreTentatives < Model.Quiz.NombreTentativesAutorisees;
                    }

                    @if (peutReessayer && !Model.EstReussie)
                    {
                        <a href="@Url.Action("CommencerQuiz", new { id = Model.QuizId })" 
                           class="btn btn-warning btn-lg">
                            <i class="bi bi-arrow-clockwise"></i> Reessayer
                            <small class="d-block mt-1">
                                (@(Model.Quiz.NombreTentativesAutorisees - nombreTentatives) tentative(s) restante(s))
                            </small>
                        </a>
                    }

                    <a href="@Url.Action("VoirCours", "Etudiant", new { id = Model.Quiz.Module.CoursId })" 
                       class="btn btn-primary btn-lg ms-2">
                        <i class="bi bi-arrow-left"></i> Retour au cours
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-box {
        padding: 1rem;
        text-align: center;
    }

    .question-result {
        transition: all 0.3s ease;
    }

    .question-result:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
</style>

