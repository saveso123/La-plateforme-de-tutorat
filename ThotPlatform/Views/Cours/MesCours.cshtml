@model IEnumerable<ThotPlatform.Models.InscriptionCours>

@{
    ViewBag.Title = "Mes Cours";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Mes Cours</h2>
            <p class="text-muted">Liste de tous les cours auxquels vous etes inscrit</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var inscription in Model)
            {
                var progression = inscription.ProgressionPourcentage;
                var progressClass = progression >= 75 ? "bg-success" : progression >= 50 ? "bg-info" : progression >= 25 ? "bg-warning" : "bg-danger";
                
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">@inscription.Cours.Nom</h5>
                            <p class="card-text text-muted">@inscription.Cours.Code</p>
                            
                            <div class="mb-3">
                                <small class="text-muted">Tuteur : @inscription.Cours.Tuteur.NomComplet</small><br>
                                <small class="text-muted">Domaine : @inscription.Cours.Domaine.Nom</small>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small>Progression</small>
                                    <small>@progression%</small>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar @progressClass" role="progressbar" style="width: @progression%" aria-valuenow="@progression" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary">@inscription.Cours.NombreModules module(s)</span>
                                @if (inscription.EstComplete)
                                {
                                    <span class="badge bg-success">? Termine</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="@Url.Action("Details", new { id = inscription.CoursId })" class="btn btn-primary btn-sm w-100">
                                Acceder au cours
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h5>Aucun cours</h5>
            <p class="mb-0">Vous n'etes inscrit a aucun cours pour le moment.</p>
            <a href="@Url.Action("Index")" class="btn btn-primary mt-3">
                Decouvrir les cours disponibles
            </a>
        </div>
    }

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Etudiant")" class="btn btn-outline-secondary">Retour au tableau de bord</a>
    </div>
</div>

