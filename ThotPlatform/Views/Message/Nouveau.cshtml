@model ThotPlatform.Models.Message

@{
    ViewBag.Title = "Nouveau message";
}

<div class="mb-3">
    <a href="@Url.Action("Index", "Message")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour a la messagerie
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-envelope"></i> Nouveau message</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Nouveau", "Message", FormMethod.Post, new { @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.DestinatireId, "Destinataire", new { @class = "form-label" })
                        
                        @if (ViewBag.DestinatireId != null)
                        {
                            @Html.Hidden("DestinatireId", (int)ViewBag.DestinatireId)
                            <input type="text" class="form-control" value="@ViewBag.DestinataireName" readonly>
                        }
                        else if (Session["UserType"]?.ToString() == "Etudiant")
                        {
                            <select name="DestinatireId" class="form-select" required>
                                <option value="">Selectionnez un tuteur</option>
                                @if (ViewBag.Tuteurs != null)
                                {
                                    foreach (ThotPlatform.Models.DestinataireDto tuteur in ViewBag.Tuteurs)
                                    {
                                        <option value="@tuteur.UtilisateurId">@tuteur.NomComplet</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <select name="DestinatireId" class="form-select" required>
                                <option value="">Selectionnez un etudiant</option>
                                @if (ViewBag.Etudiants != null)
                                {
                                    foreach (ThotPlatform.Models.DestinataireDto etudiant in ViewBag.Etudiants)
                                    {
                                        <option value="@etudiant.UtilisateurId">@etudiant.NomComplet</option>
                                    }
                                }
                            </select>
                        }
                        @Html.ValidationMessageFor(m => m.DestinatireId, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Sujet, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Sujet, new { @class = "form-control", placeholder = "Sujet du message" })
                        @Html.ValidationMessageFor(m => m.Sujet, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Contenu, "Message", new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Contenu, new { @class = "form-control", rows = 10, placeholder = "ecrivez votre message ici..." })
                        @Html.ValidationMessageFor(m => m.Contenu, "", new { @class = "text-danger" })
                    </div>

                    if (ViewBag.MessageOriginal != null)
                    {
                        var messageOriginal = (ThotPlatform.Models.Message)ViewBag.MessageOriginal;
                        <text>
                        <div class="card bg-light mb-3">
                            <div class="card-header">
                                <small class="text-muted">Message original</small>
                            </div>
                            <div class="card-body">
                                <h6>@messageOriginal.Sujet</h6>
                                <p class="mb-0">@messageOriginal.Contenu</p>
                                <small class="text-muted">
                                    De: @messageOriginal.Expediteur.NomComplet - @messageOriginal.DateEnvoi.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        </div>
                        </text>
                    }

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-send"></i> Envoyer le message
                        </button>
                        <a href="@Url.Action("Index", "Message")" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

